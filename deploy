#!/usr/bin/env bash

# This script builds + deploys the website on my DigitalOcean VPS
# It assumes you've got SSH access, and a private key in ~/.ssh/do_dmoffat.com
set -euo pipefail

echo "Deploying website..."

source .env

# Build and publish the nginx container
./build-publish-nginx

# Deploy remotely
ssh -i ~/.ssh/do_dmoffat.com dmoffat.com -p 9999 "DO_TOKEN='$DIGITALOCEAN_API_KEY' bash -s" << 'EOF'
    set -euo pipefail

    echo "Authenticating with the registry"
    docker login -u danmofo@gmail.com -p "$DO_TOKEN" registry.digitalocean.com

    echo "Pulling the container..."
    docker pull registry.digitalocean.com/dmoffat/dmoffat-nginx:latest

    # Shared with the trips container, which this nginx proxies to by container name. Idempotent —
    # whichever project deploys first creates it.
    docker network create web 2>/dev/null || true

    echo "Killing existing container..."
    docker rm -f dmoffat-nginx 2>/dev/null || true

    echo "Running new container..."
    docker run -d \
        -p 80:8080 \
        -p 443:8443 \
        --network web \
        --restart unless-stopped \
        --name dmoffat-nginx \
        registry.digitalocean.com/dmoffat/dmoffat-nginx

    echo "Running:"
    docker ps --filter name=dmoffat-nginx --format '{{.Names}}  {{.Status}}'
EOF

echo "Deployed. Check https://www.dmoffat.com"
